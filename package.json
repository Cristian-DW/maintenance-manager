{
    "name": "maintenance-manager",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "cds run",
        "dev": "cds watch",
        "build": "cds build/all",
        "deploy": "cds deploy",
        "serve:backend": "cds run --with-mocks",
        "serve:ui": "cd app/maintenance-manager-ui && npm run dev",
        "serve:all": "concurrently \"npm run serve:backend\" \"npm run serve:ui\"",
        "setup": "npm install && cd app/maintenance-manager-ui && npm install",
        "build:all": "npm run build && cd app/maintenance-manager-ui && npm run build",
        "test": "jest",
        "lint": "eslint .",
        "db:init": "rm -f maintenance.db* && cds deploy --to sqlite:maintenance.db",
        "db:seed": "node ./db/data/seed.js",
        "clean": "rimraf dist gen node_modules */*/node_modules db.sqlite* maintenance.db*"
    },
    "dependencies": {
        "@sap/cds": "^9.3.1",
        "@sap/xssec": "^4",
        "bcryptjs": "^2.4.3",
        "dotenv": "^17.2.3",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.1",
        "jsonwebtoken": "^9.0.2",
        "sqlite3": "^5.1.7",
        "uuid": "^13.0.0",
        "winston": "^3.18.3"
    },
    "engines": {
        "node": ">=18"
    },
    "cds": {
        "requires": {
            "db": {
                "kind": "sqlite",
                "model": "db/"
            },
            "auth": {
                "kind": "dummy"
            },
            "[production]": {
                "auth": "xsuaa"
            }
        }
    },
    "devDependencies": {
        "@cap-js/sqlite": "^2.0.3",
        "concurrently": "^8.2.2",
        "eslint": "^8.55.0",
        "jest": "^29.7.0",
        "rimraf": "^5.0.5",
        "supertest": "^6.3.3"
    }
}