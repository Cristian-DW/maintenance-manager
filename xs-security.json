{
  "xsappname": "maintenance-manager",
  "tenant-mode": "dedicated",
  "description": "Security descriptor for Maintenance Manager",
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Administrator"
    },
    {
      "name": "$XSAPPNAME.Manager",
      "description": "Manager"
    },
    {
      "name": "$XSAPPNAME.Technician",
      "description": "Technician"
    },
    {
      "name": "$XSAPPNAME.Requester",
      "description": "Requester"
    }
  ],
  "role-templates": [
    {
      "name": "Admin",
      "description": "Administrator with full access",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "Manager",
      "description": "Manager with oversight access",
      "scope-references": [
        "$XSAPPNAME.Manager"
      ]
    },
    {
      "name": "Technician",
      "description": "Technician who handles maintenance requests",
      "scope-references": [
        "$XSAPPNAME.Technician"
      ]
    },
    {
      "name": "Requester",
      "description": "User who can create maintenance requests",
      "scope-references": [
        "$XSAPPNAME.Requester"
      ]
    }
  ]
}